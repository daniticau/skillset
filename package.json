{
  "name": "skillset-cli",
  "version": "0.2.0",
  "description": "One skill library for every coding agent. Skillset keeps your skills in one place and syncs them into Claude Code, Codex, Kimi Code, Grok, and Cursor.",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "license": "MIT",
  "author": "Daniel Ticau",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daniticau/skillset.git"
  },
  "homepage": "https://skillset.daniticau.com",
  "bugs": {
    "url": "https://github.com/daniticau/skillset/issues"
  },
  "keywords": [
    "claude-code",
    "codex",
    "cursor",
    "kimi-code",
    "grok",
    "agent-skills",
    "skills",
    "skill-md"
  ],
  "os": [
    "darwin"
  ],
  "bin": {
    "skillset-cli": "dist/cli.js",
    "skillset": "dist/cli.js",
    "sks": "dist/cli.js"
  },
  "files": [
    "dist",
    "dist-app",
    "app",
    "skills"
  ],
  "scripts": {
    "app:build": "./desktop/build-app.sh",
    "app:install": "./desktop/install-app.sh",
    "app:run": "pnpm app:build && open ./desktop/build/Skillset.app",
    "build": "tsup",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "dev": "tsup --watch",
    "prepack": "pnpm app:release",
    "prepublishOnly": "pnpm typecheck && pnpm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "start": "node ./dist/cli.js",
    "cli": "node ./dist/cli.js",
    "cli:link": "node scripts/link-cli.mjs",
    "app:release": "./desktop/build-app.sh --release && rm -rf app && mkdir app && ditto desktop/build/Skillset.app app/Skillset.app"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "gray-matter": "^4.0.3",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
