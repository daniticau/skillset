{
  "name": "skillset",
  "version": "0.1.0",
  "description": "Portable personalization layer for coding agents. Alpha, Windows + Claude Code first-class today.",
  "type": "module",
  "license": "MIT",
  "author": "Daniel Ticau",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daniticau/skillset.git"
  },
  "homepage": "https://github.com/daniticau/skillset#readme",
  "bugs": {
    "url": "https://github.com/daniticau/skillset/issues"
  },
  "keywords": [
    "claude-code",
    "cursor",
    "codex",
    "agent",
    "skills",
    "personalization",
    "llm"
  ],
  "os": [
    "win32"
  ],
  "bin": {
    "skillset": "./dist/cli.js",
    "sks": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "start": "node ./dist/cli.js",
    "cli": "bun run src/cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "better-sqlite3": "^12.9.0",
    "commander": "^12.1.0",
    "gray-matter": "^4.0.3",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
