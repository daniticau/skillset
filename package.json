{
  "name": "skillset-cli",
  "version": "0.1.1",
  "description": "Portable personalization layer for coding agents. Alpha, macOS with Claude Code and Codex Desktop skills.",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "license": "MIT",
  "author": "Daniel Ticau",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daniticau/skillset.git"
  },
  "homepage": "https://github.com/daniticau/skillset#readme",
  "bugs": {
    "url": "https://github.com/daniticau/skillset/issues"
  },
  "keywords": [
    "claude-code",
    "codex",
    "agent",
    "skills",
    "personalization",
    "llm"
  ],
  "os": [
    "darwin"
  ],
  "bin": {
    "skillset-cli": "dist/cli.js",
    "skillset": "dist/cli.js",
    "sks": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "dev": "tsup --watch",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm typecheck && pnpm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "start": "node ./dist/cli.js",
    "cli": "node ./dist/cli.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "commander": "^12.1.0",
    "gray-matter": "^4.0.3",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
